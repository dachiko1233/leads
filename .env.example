# ---- Data engine (Google Places API) ----------------------------------
# Google Places API (New) key. Enable "Places API (New)" in Google Cloud.
GOOGLE_PLACES_API_KEY=
# true -> use data/leads.sample.json instead of live Google calls (offline dev)
USE_SAMPLE_DATA=false

# ---- Dodo Payments -----------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test          # test | live
# The €1 "lead" product id from your Dodo dashboard (quantity = number of leads).
DODO_LEAD_PRODUCT_ID=

# ---- Resend (email delivery) -------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@yourdomain.com
