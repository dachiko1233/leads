# ---- App -----------------------------------------------------------------
# Public base URL of the deployed app. Used to build Dodo return_url.
# e.g. https://getghostleads.com  (no trailing slash)
APP_URL=

# ---- Dodo Payments -------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# The "Pay What You Want" (EUR) product id from your Dodo dashboard.
DODO_PRODUCT_ID=
# test | live
DODO_ENVIRONMENT=test

# ---- Data engine (Google Places API New) ---------------------------------
# Google Places API (New) key. Enable "Places API (New)" in Google Cloud.
GOOGLE_PLACES_API_KEY=
# true -> read data/leads.sample.json instead of live Google calls (offline dev)
USE_SAMPLE_DATA=false

# ---- Resend (email delivery) ---------------------------------------------
RESEND_API_KEY=
# Must be a verified sender/domain in Resend.
RESEND_FROM_EMAIL=leads@yourdomain.com
